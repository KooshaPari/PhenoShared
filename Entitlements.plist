<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal entitlements for Electron desktop apps.
  electron-builder applies these automatically when configured in package.json:
    "mac": { "hardenedRuntime": true, "entitlements": "build/entitlements.mac.plist" }

  AUDIT 2026-09-10 (batch IND:035-037):
  - Removed duplicate keys (com.apple.security.cs.allow-jit, com.apple.security.network.client)
    that previously appeared twice each — Apple notarization would have warned on plutil -lint.
  - com.apple.security.cs.disable-library-validation intentionally LEFT DISABLED.
    electron-updater requires it ONLY if the app ships auto-update. Pheno desktop's
    release pipeline (release-macos.yml) does NOT enable auto-update (the app-bundle
    is signed and notarized but no Squirrel.Mac / autoUpdater wiring is present in
    apps/desktop). To enable auto-update later, uncomment the disable-library-validation
    block below and add `autoUpdater` wiring; that decision is operator-reserved.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <key>com.apple.security.network.client</key>
  <true/>

  <!-- electron-updater needs this to download and run the update binary.
       Add ONLY if you ship auto-update. Currently disabled: pheno desktop does
       not ship auto-update. See AUDIT note above. -->
  <!-- <key>com.apple.security.cs.disable-library-validation</key>
  <true/> -->
</dict>
</plist>
