#!/bin/bash
#==========================================
# pheno-llm - LLM Inference Service Manager
#==========================================

set -e

# Configuration
SERVICE_NAME="pheno-llm"
HOST_IP="100.96.135.160"
DEFAULT_PORT=8080
MODELS_DIR="$HOME/llm-models"
LOG_DIR="$HOME/pheno-llm/logs"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

#----------------------------------
# Model Registry
#----------------------------------
declare -A MODELS=(
    ["qwen3.6-moeq4"]="unsloth/Qwen3.6-35B-A3B-GGUF:Qwen3.6-35B-A3B-Q4_K_M.gguf"
    ["qwen3.6-moeq6"]="unsloth/Qwen3.6-35B-A3B-GGUF:Qwen3.6-35B-A3B-Q6_K.gguf"
    ["qwen3.6-moeq8"]="unsloth/Qwen3.6-35B-A3B-GGUF:Qwen3.6-35B-A3B-Q8_0.gguf"
    ["qwen3.6-reap"]="mradermacher/Qwen3.6-28B-REAP-GGUF:Qwen3.6-28B-REAP-Q4_K_M.gguf"
    ["granite4.1-8b-q4"]="unsloth/granite-4.1-8b-GGUF:granite-4.1-8b-Q4_K_M.gguf"
    ["granite4.1-8b-q6"]="unsloth/granite-4.1-8b-GGUF:granite-4.1-8b-Q6_K.gguf"
    ["granite4.1-30b-q4"]="unsloth/granite-4.1-30b-GGUF:granite-4.1-30b-Q4_K_M.gguf"
    ["granite3.1-8b-q4"]="unsloth/granite-3.1-8b-instruct-GGUF:granite-3.1-8b-instruct-Q4_K_M.gguf"
)

#----------------------------------
# Connection
#----------------------------------
SSH_TARGET="desk"

ssh_cmd() {
    ssh -o BatchMode=yes "$SSH_TARGET" "$@"
}

#----------------------------------
# Service Control
#----------------------------------
start_server() {
    local model_key="${1:-qwen3.6-moeq4}"
    local port="${2:-$DEFAULT_PORT}"

    if [[ -z "${MODELS[$model_key]}" ]]; then
        log_error "Unknown model: $model_key"
        echo "Available models:"
        for key in "${!MODELS[@]}"; do echo "  - $key"; done
        return 1
    fi

    local model_info="${MODELS[$model_key]}"
    local repo="${model_info%%:*}"
    local filename="${model_info##*:}"
    local model_path="$MODELS_DIR/${repo##*/}/$filename"

    log_info "Starting $model_key on port $port"
    log_info "Model: $repo/$filename"

    ssh_cmd "wsl -d Ubuntu-22.04 -e bash -c '
        cd ~/llm-server
        export MODEL_PATH=\"$model_path\"
        export PORT=$port
        nohup ./start_server.sh > server.log 2>&1 &
        sleep 2
        curl -s http://localhost:$port/v1/models > /dev/null && echo \"Server started on port $port\" || echo \"Server failed to start\"
    '"
}

stop_server() {
    local port="${1:-$DEFAULT_PORT}"
    log_info "Stopping server on port $port"
    ssh_cmd "wsl -d Ubuntu-22.04 -e pkill -f 'llama-server.*--port $port'" || true
}

restart_server() {
    stop_server "$2"
    start_server "$1" "$2"
}

#----------------------------------
# Status
#----------------------------------
status() {
    log_info "LLM Service Status"
    echo ""
    ssh_cmd "wsl -d Ubuntu-22.04 -e screen -ls 2>/dev/null | grep llama || echo 'No screen sessions'"
    echo ""
    log_info "Testing API..."
    curl -s --max-time 5 "http://localhost:$DEFAULT_PORT/v1/models" > /dev/null \
        && log_info "Server responding on port $DEFAULT_PORT" \
        || log_warn "Server not responding on port $DEFAULT_PORT"
}

gpu_status() {
    log_info "GPU Status"
    ssh_cmd "wsl -d Ubuntu-22.04 -e nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu --format=csv,noheader"
}

#----------------------------------
# Model Management
#----------------------------------
list_models() {
    log_info "Available Models"
    echo ""
    for key in "${!MODELS[@]}"; do
        local info="${MODELS[$key]}"
        local repo="${info%%:*}"
        local file="${info##*:}"
        echo "  $key: $file"
    done
}

download_model() {
    local model_key="$1"
    if [[ -z "${MODELS[$model_key]}" ]]; then
        log_error "Unknown model: $model_key"
        return 1
    fi

    local model_info="${MODELS[$model_key]}"
    local repo="${model_info%%:*}"
    local filename="${model_info##*:}"
    local model_dir="$MODELS_DIR/${repo##*/}"
    local model_path="$model_dir/$filename"

    log_info "Downloading $repo/$filename"
    ssh_cmd "wsl -d Ubuntu-22.04 -e bash -c '
        mkdir -p \"$model_dir\"
        cd \"$model_dir\"
        if [ -f \"$filename\" ]; then
            echo \"Model already exists\"
        else
            huggingface-cli download \"$repo\" \"$filename\" --local-dir \"$model_dir\"
        fi
        ls -lh \"$model_dir\"
    '"
}

#----------------------------------
# API Testing
#----------------------------------
test_chat() {
    local prompt="${1:-'Hello! What is 2+2?'}"
    local model="${2:-qwen3.6-moeq4}"
    local port="${3:-$DEFAULT_PORT}"

    log_info "Testing chat with model: $model"

    local model_info="${MODELS[$model]}"
    local filename="${model_info##*:}"

    curl -s --max-time 60 "http://localhost:$port/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "{
            \"model\": \"$filename\",
            \"messages\": [{\"role\": \"user\", \"content\": \"$prompt\"}],
            \"max_tokens\": 100
        }" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if 'choices' in data:
    print(data['choices'][0]['message']['content'])
else:
    print(json.dumps(data, indent=2))
"
}

#----------------------------------
# Help
#----------------------------------
show_help() {
    cat << 'EOF'
pheno-llm - LLM Inference Service Manager

Usage: pheno-llm <command> [args]

Commands:
  start [model] [port]    Start inference server
  stop [port]             Stop server
  restart [model] [port]  Restart server
  status                  Show service status
  gpu                     Show GPU status
  list                    List available models
  download <model>        Download a model
  test [prompt] [model]   Test chat completion
  logs                    Show server logs

Examples:
  pheno-llm start qwen3.6-moeq4 8080
  pheno-llm start granite4.1-8b-q4 8081
  pheno-llm test "Explain quantum computing"
  pheno-llm download granite3.1-8b-q4
EOF
}

#----------------------------------
# Main
#----------------------------------
main() {
    case "${1:-}" in
        start) shift; start_server "$@" ;;
        stop) shift; stop_server "$@" ;;
        restart) shift; restart_server "$@" ;;
        status) status ;;
        gpu|g) gpu_status ;;
        list|l) list_models ;;
        download|dl) shift; download_model "$@" ;;
        test|t) shift; test_chat "$@" ;;
        logs) ssh_cmd "wsl -d Ubuntu-22.04 -e tail -50 ~/llm-server/server.log" ;;
        help|h|"") show_help ;;
        *) log_error "Unknown command: $1"; show_help; exit 1 ;;
    esac
}

main "$@"
