#!/bin/bash
# pheno-llm - Inference server management for pheno-compute-layer
# Usage: pheno-llm [start|stop|restart|status|logs] [model]

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
CONFIG_DIR="$PROJECT_ROOT/config"
LOG_DIR="$PROJECT_ROOT/logs"
MODEL_DIR="$PROJECT_ROOT/models"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# SSH target
SSH_TARGET="desk"
SSH_CMD="ssh $SSH_TARGET"

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Load config if exists
load_config() {
    if [ -f "$CONFIG_DIR/models.conf" ]; then
        source "$CONFIG_DIR/models.conf"
    fi
}

# Check server status
status() {
    log_info "Checking inference server status..."
    local result
    result=$($SSH_CMD 'cmd /c wsl -d Ubuntu-22.04 -e bash -c "ps aux"' 2>/dev/null | grep llama-server | grep -v grep | head -1)
    if [ -n "$result" ]; then
        log_info "Server is running: $result"
        curl -s --connect-timeout 3 http://100.96.135.160:8080/v1/models > /dev/null 2>&1
        if [ $? -eq 0 ]; then
            log_info "Server is responding on port 8080"
        else
            log_warn "Server process running but not responding"
        fi
    else
        log_warn "Server is not running"
    fi
}

# Start server
start() {
    local model="${1:-granite-4.1-8b-Q4_K_M}"
    log_info "Starting llama-server with model: $model"

    # Kill existing server
    stop

    # Start new server
    $SSH_CMD 'cmd /c wsl -d Ubuntu-22.04 -e bash -c "sed -i s/\r$// /mnt/c/Users/koosh/run-granite.sh && bash /mnt/c/Users/koosh/run-granite.sh"'

    log_info "Server starting... (wait 10s)"
    sleep 10
    status
}

# Stop server
stop() {
    log_info "Stopping llama-server..."
    $SSH_CMD 'cmd /c wsl -d Ubuntu-22.04 -e bash -c "pkill -f llama-server 2>/dev/null || true"'
}

# Restart server
restart() {
    stop
    sleep 2
    start "$@"
}

# View logs
logs() {
    $SSH_CMD 'cmd /c wsl -d Ubuntu-22.04 -e bash -c "tail -f /home/kooshapari/llm-server/granite.log"'
}

# Download a model
download() {
    local model="$1"
    local quant="${2:-Q4_K_M}"
    if [ -z "$model" ]; then
        log_error "Usage: pheno-llm download <model> [quantization]"
        exit 1
    fi
    log_info "Downloading $model ($quant)..."
    # Implementation depends on model source
    log_warn "Not yet implemented - use hf_hub_download or huggingface-cli"
}

# List available models
list_models() {
    log_info "Available models in WSL:"
    $SSH_CMD 'cmd /c wsl -d Ubuntu-22.04 -e bash -c "ls -lh /home/kooshapari/llm-models/" 2>/dev/null'
}

# Test inference
test() {
    log_info "Testing inference..."
    curl -s http://100.96.135.160:8080/v1/chat/completions \
        -H "Content-Type: application/json" \
        -d '{"messages":[{"role":"user","content":"What is 2+2?"}],"max_tokens":50,"stream":false}' \
        | python3 -c "import sys,json; d=json.load(sys.stdin); print('Response:', d['choices'][0]['message']['content'])"
}

# Show usage
usage() {
    echo "pheno-llm - Inference server management"
    echo ""
    echo "Usage: pheno-llm <command> [options]"
    echo ""
    echo "Commands:"
    echo "  start [model]     Start the inference server"
    echo "  stop              Stop the inference server"
    echo "  restart [model]   Restart the inference server"
    echo "  status            Show server status"
    echo "  logs              Stream server logs"
    echo "  list              List available models"
    echo "  test              Test inference"
    echo "  download <model> [quant]  Download a model"
    echo ""
    echo "Examples:"
    echo "  pheno-llm start granite-4.1-8b-Q4_K_M"
    echo "  pheno-llm status"
    echo "  pheno-llm test"
}

# Main
load_config

case "${1:-}" in
    start) shift; start "$@" ;;
    stop) stop ;;
    restart) shift; restart "$@" ;;
    status) status ;;
    logs) logs ;;
    list) list_models ;;
    test) test ;;
    download) shift; download "$@" ;;
    help|--help|-h) usage ;;
    *) usage ;;
esac
