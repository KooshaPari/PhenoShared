<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.kooshapari.browser-broker

  Runs `brokerd` (the lease-guarded browser broker) as a per-user launchd agent
  so it survives logout and reboot instead of being an ad-hoc background shell.

  Listens on 127.0.0.1:8788 ONLY (loopback). Port 8787 belongs to a herdr
  control bridge and is deliberately NOT used here.

  The bearer token is NOT in this plist and NOT in argv. The wrapper
  ~/.local/bin/browser-broker-run sources
  ~/.local/state/browser-broker.env (mode 600) and exports BROKER_TOKEN into
  the process environment; brokerd is told only the VARIABLE NAME, through its
  token-env flag.

  State root: ~/.local/state/browser-broker
  Log:        ~/.local/state/brokerd.log
  Docs:       ~/.local/state/browser-broker.README.md

  Manage with:
    launchctl print   gui/$(id -u)/com.kooshapari.browser-broker
    launchctl kickstart -k gui/$(id -u)/com.kooshapari.browser-broker   # restart
    launchctl bootout  gui/$(id -u)/com.kooshapari.browser-broker       # stop
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kooshapari.browser-broker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kooshapari/.local/bin/browser-broker-run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash or signal, but not after a clean exit(0). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Do not spin: at most one restart per 10s. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/kooshapari/.local/state/brokerd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kooshapari/.local/state/brokerd.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/kooshapari</string>

    <!-- Background service: do not fight the interactive UI for CPU/IO. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>

    <!-- No on-demand socket activation: brokerd owns its own listener. -->
    <key>AbandonProcessGroup</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/kooshapari/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
