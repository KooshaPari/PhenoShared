{
  "name": "phenodocs",
  "version": "0.1.0",
  "private": true,
  "description": "VitePress Federation Hub - Aggregate documentation from multiple projects",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "lint": "markdownlint docs/**/*.md",
    "lint:ts": "oxlint .vitepress --config oxlint.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check": "bun run lint:ts && bun run typecheck && uv run python scripts/check_docs_links.py",
    "check-links": "uv run python scripts/check_docs_links.py",
    "test:a11y": "vitest run tests/a11y",
    "test:a11y:watch": "vitest tests/a11y",
    "check:alts": "node scripts/check-image-alts.mjs",
    "check:locales": "node scripts/verify-locale-coverage.mjs"
  },
  "dependencies": {
    "@phenotype/design": "github:KooshaPari/phenoDesign",
    "@phenotype/docs": "workspace:*",
    "vitepress": "^1.5.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.62.1",
    "axe-core": "^4.10.3",
    "markdownlint-cli": "^0.49.0",
    "oxlint": "^1.57.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "documentation",
    "vitepress",
    "federation",
    "hub",
    "multi-project"
  ],
  "author": "Kush Team",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ]
}
