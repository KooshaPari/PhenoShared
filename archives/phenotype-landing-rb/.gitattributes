# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.tar.gz binary

# Generated / build artifacts
sites/*/dist/** linguist-generated=true
sites/*/.astro/** linguist-generated=true

# Lockfiles — diff not useful
*.lock binary
bun.lockb binary
