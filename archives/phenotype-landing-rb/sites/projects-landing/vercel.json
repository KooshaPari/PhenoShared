{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "trailingSlash": false,
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron-refresh",
      "schedule": "17 7 * * *"
    }
  ]
}
