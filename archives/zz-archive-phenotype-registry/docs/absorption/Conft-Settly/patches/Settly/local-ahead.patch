+    branches: [main]
+  pull_request:
+    branches: [main]
+  schedule:
+    # Weekly on Mondays at 06:00 UTC
+    - cron: "0 6 * * 1"
+  workflow_dispatch:
+
+permissions: read-all
+
+jobs:
+  scorecard:
+    name: OpenSSF Scorecard
+    runs-on: ubuntu-latest
+    permissions:
+      # Required for the scorecard action to publish results
+      security-events: write
+      # id-token: write is required for the scorecard-action's OIDC token
+      id-token: write
+      contents: read
+      actions: read
+    steps:
+      - name: Checkout source
+        uses: actions/checkout@v6
+        with:
+          persist-credentials: false
+
+      - name: Run OpenSSF Scorecard
+        uses: ossf/scorecard-action@v2.4.3
+        with:
+          # Branch to evaluate; this is the canonical branch for the repo.
+          branch: ${{ github.event.repository.default_branch }}
+          # Scorecard results are published to the security-tab.
+          results_file: results.sarif
+          results_format: sarif
+          # Publish results to the Security tab of the repo.
+          publish_results: true
+        env:
+          # PAT or GITHUB_AUTH_TOKEN with repo:security_events scope.
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+
+      # Upload SARIF to the GitHub code-scanning dashboard for trend visibility.
+      - name: Upload SARIF results
+        if: always()
+        uses: github/codeql-action/upload-sarif@v4
+        with:
+          sarif_file: results.sarif
+          category: scorecard
