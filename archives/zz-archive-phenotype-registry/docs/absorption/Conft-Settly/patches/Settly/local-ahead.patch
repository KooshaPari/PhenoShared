@@ -0,0 +1,130 @@
+//! Framework-level configuration for Settly itself.
+//!
+//! `SettlySettings` controls how the library behaves — timeouts, retries,
+//! cache policies, etc.  It can be serialised / deserialised alongside
+//! user configuration (as a reserved `settly` key) or constructed
+//! programmatically.
+//!
+//! # Defaults
+//!
+//! Every field has a sensible default exposed via `Default`, so you only
+//! need to set the values you want to override.
+//!
+//! ```rust
+//! use settly::domain::settings::SettlySettings;
+//!
+//! let settings = SettlySettings::default();
+//! assert_eq!(settings.idempotency_ttl_secs, 86_400);
+//! assert_eq!(settings.max_retries, 3);
+//! ```
+
+use serde::{Deserialize, Serialize};
+use std::time::Duration;
+
+// ---------------------------------------------------------------------------
+// Named constants — useful when you want to reference a default inline.
+// ---------------------------------------------------------------------------
+
+/// Default TTL for idempotency cache entries (24 hours in seconds).
+pub const DEFAULT_IDEMPOTENCY_TTL_SECS: u64 = 86_400;
+
+/// Default maximum retry attempts for submission execution.
+pub const DEFAULT_MAX_RETRIES: u32 = 3;
+
+// ---------------------------------------------------------------------------
+// Settings struct
+// ---------------------------------------------------------------------------
+
+/// Top-level framework settings for Settly.
+///
+/// | Field                 | Type    | Default | Description                               |
+/// |-----------------------|---------|---------|-------------------------------------------|
+/// | `idempotency_ttl_secs` | `u64`  | 86400   | Idempotency cache TTL (seconds).          |
+/// | `max_retries`         | `u32`   | 3       | Max retry attempts per submission.        |
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct SettlySettings {
+    /// TTL for idempotency cache entries in seconds.
+    /// Default: 86_400 (24 hours).
+    #[serde(default = "default_idempotency_ttl_secs")]
+    pub idempotency_ttl_secs: u64,
+
+    /// Maximum number of retry attempts per submission.
+    /// Default: 3.
+    #[serde(default = "default_max_retries")]
+    pub max_retries: u32,
+}
+
+// ---------------------------------------------------------------------------
+// Serde default helpers
+// ---------------------------------------------------------------------------
+
+fn default_idempotency_ttl_secs() -> u64 {
+    DEFAULT_IDEMPOTENCY_TTL_SECS
+}
+
+fn default_max_retries() -> u32 {
+    DEFAULT_MAX_RETRIES
+}
+
+// ---------------------------------------------------------------------------
+// Default impl
+// ---------------------------------------------------------------------------
+
+impl Default for SettlySettings {
+    fn default() -> Self {
+        Self {
+            idempotency_ttl_secs: DEFAULT_IDEMPOTENCY_TTL_SECS,
+            max_retries: DEFAULT_MAX_RETRIES,
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Convenience accessors
+// ---------------------------------------------------------------------------
+
+impl SettlySettings {
+    /// Return the idempotency TTL as a `Duration`.
+    pub fn idempotency_ttl(&self) -> Duration {
+        Duration::from_secs(self.idempotency_ttl_secs)
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Tests
+// ---------------------------------------------------------------------------
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_defaults() {
+        let settings = SettlySettings::default();
+        assert_eq!(settings.idempotency_ttl_secs, 86_400);
+        assert_eq!(settings.max_retries, 3);
+    }
+
+    #[test]
+    fn test_ttl_duration() {
+        let settings = SettlySettings::default();
+        assert_eq!(settings.idempotency_ttl(), Duration::from_secs(86_400));
+    }
+
+    #[test]
+    fn test_serde_roundtrip() {
+        let settings = SettlySettings::default();
+        let json = serde_json::to_string(&settings).unwrap();
+        let deserialized: SettlySettings = serde_json::from_str(&json).unwrap();
+        assert_eq!(settings, deserialized);
+    }
+
+    #[test]
+    fn test_deserialize_partial() {
+        let json = r#"{"max_retries": 5}"#;
+        let settings: SettlySettings = serde_json::from_str(json).unwrap();
+        // idempotency_ttl_secs should fall back to default
+        assert_eq!(settings.idempotency_ttl_secs, 86_400);
+        assert_eq!(settings.max_retries, 5);
+    }
+}
