@@ -0,0 +1,132 @@
+name: Audit
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+  schedule:
+    # Daily at 03:00 UTC — offsets cargo-deny (Mon 09:00) and scorecard (Mon 06:00)
+    - cron: "0 3 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  security-events: write
+
+jobs:
+  # Aggregate advisories across crates.io / OSV / GHSA into one SARIF
+  audit:
+    name: RustSec Audit
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+        with:
+          persist-credentials: false
+
+      - name: Install Rust toolchain
+        uses: dtolnay/rust-toolchain@stable
+
+      - name: Cache cargo registry
+        uses: Swatinem/rust-cache@v2
+        with:
+          cache-on-failure: true
+
+      - name: Install cargo-audit
+        run: cargo install --locked cargo-audit
+
+      - name: Run cargo-audit
+        run: cargo audit --deny warnings
+
+      - name: Convert cargo-audit JSON to SARIF
+        if: always()
+        run: |
+          set -euo pipefail
+          cargo audit --json > audit.json || true
+          if [ -s audit.json ]; then
+            # cargo-audit emits a JSON object with a `.vulnerabilities` array.
+            # Convert that into SARIF so the result lands in the Security tab.
+            python3 - <<'PY'
+          import json, datetime, sys
+          with open("audit.json") as f:
+              data = json.load(f)
+          vulns = data.get("vulnerabilities", {}).get("found", []) if isinstance(data.get("vulnerabilities"), dict) else []
+          if not vulns:
+              print("No vulnerabilities found.", file=sys.stderr)
+              sys.exit(0)
+          results = []
+          for v in vulns:
+              ad = v.get("advisory", {})
+              results.append({
+                  "ruleId": ad.get("id", "RUSTSEC"),
+                  "level": "error",
+                  "message": {"text": ad.get("title", "RustSec advisory")},
+                  "locations": [{
+                      "physicalLocation": {
+                          "artifactLocation": {"uri": "Cargo.lock"}
+                      }
+                  }]
+              })
+          sarif = {
+              "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
+              "version": "2.1.0",
+              "runs": [{
+                  "tool": {"driver": {"name": "cargo-audit", "version": data.get("database", {}).get("version", "unknown")}},
+                  "results": results,
+              }],
+          }
+          with open("audit.sarif", "w") as f:
+              json.dump(sarif, f)
+          PY
+          fi
+
+      - name: Upload SARIF
+        if: always() && hashFiles('audit.sarif') != ''
+        uses: github/codeql-action/upload-sarif@v4
+        with:
+          sarif_file: audit.sarif
+          category: cargo-audit
+
+  # Supply-chain license + source verification via cargo-deny
+  deny:
+    name: cargo-deny
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+        with:
+          persist-credentials: false
+
+      - name: Install Rust toolchain
+        uses: dtolnay/rust-toolchain@stable
+
+      - name: Cache cargo
+        uses: Swatinem/rust-cache@v2
+        with:
+          cache-on-failure: true
+
+      - name: cargo-deny
+        uses: EmbarkStudios/cargo-deny-action@v2
+        with:
+          rust-version: stable
+          command: check
+          arguments: --hide-inclusion-graph
+
+  # Outdated dependency visibility (informational, never failing)
+  outdated:
+    name: Outdated Dependencies
+    runs-on: ubuntu-latest
+    continue-on-error: true
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+
+      - name: Install Rust toolchain
+        uses: dtolnay/rust-toolchain@stable
+
+      - name: Install cargo-outdated
+        run: cargo install --locked cargo-outdated
+
+      - name: Show outdated dependencies
+        run: cargo outdated --workspace --root-deps-only --exit-code 0
