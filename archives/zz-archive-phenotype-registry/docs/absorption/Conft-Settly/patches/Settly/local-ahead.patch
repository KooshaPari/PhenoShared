+# justfile — Settly
+# https://github.com/casey/just
+#
+# Settly is now maintained inside the Configra mono-repo. This justfile
+# mirrors the most common Taskfile targets so contributors can use either
+# command runner when iterating on this standalone repository.
+#
+# Usage:
+#     just                # show this help
+#     just check          # fmt-check + clippy + test
+#     just ci             # full CI-equivalent pipeline
+#     just audit          # security audits (deny + audit + outdated)
+
+set dotenv-load := false
+set positional-arguments := true
+
+# Default: list available recipes
+default:
+    @just --list
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Setup
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Install recommended cargo extensions
+install-tools:
+    cargo install --locked cargo-deny || true
+    cargo install --locked cargo-audit || true
+    cargo install --locked cargo-outdated || true
+    cargo install --locked cargo-llvm-cov || true
+    rustup component add rustfmt clippy
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Build
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Build the library and binaries in debug mode
+build:
+    cargo build --all-targets
+
+# Build optimized release artifacts
+build-release:
+    cargo build --release --all-targets
+
+# Check the whole workspace without producing artifacts
+check-workspace:
+    cargo check --all-targets --all-features
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Format & Lint
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Format all code (in-place)
+fmt:
+    cargo fmt --all
+
+# Verify formatting (CI mode)
+fmt-check:
+    cargo fmt --all -- --check
+
+# Run clippy with warnings-as-errors
+lint:
+    cargo clippy --all-targets --all-features -- -D warnings
+
+# Run clippy with security-focused lints
+lint-security:
+    cargo clippy --all-targets --all-features -- \
+        -D warnings \
+        -W clippy::panic \
+        -W clippy::unwrap_used \
+        -W clippy::expect_used \
+        -W clippy::todo \
+        -W clippy::dbg_macro
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Test
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Run unit + integration tests
+test:
+    cargo test --all-features
+
+# Run all tests including doctests
+test-all:
+    cargo test --all-features --doc
+    cargo test --all-features
+
+# Run tests with nextest (faster, better UX)
+test-nextest:
+    cargo nextest run --all-features
+
+# Run tests and generate coverage report
+coverage:
+    cargo llvm-cov --all-features --workspace --html
+    @echo "Coverage report at target/llvm-cov/html/index.html"
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Security & Supply Chain
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Run cargo-deny against deny.toml
+deny:
+    cargo deny check
+
+# Run cargo-audit against Cargo.lock
+audit:
+    cargo audit
+
+# Show outdated dependencies
+outdated:
+    cargo outdated --workspace --root-deps-only
+
+# Aggregate security pipeline
+security: deny audit outdated
+    @echo "Security checks complete."
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Aggregate pipelines
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Quick local check (format + lint + test)
+check: fmt-check lint test
+    @echo "✓ check passed"
+
+# Strict CI-equivalent pipeline
+ci: fmt-check lint-security test-all security
+    @echo "✓ CI pipeline passed"
+
+# Full quality gate used before opening a PR
+precommit: fmt-check lint-security test-all
+    @echo "✓ precommit checks passed"
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Documentation
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Build rustdoc with broken-link detection
+doc:
+    RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features
+
+# Open the locally-built rustdoc in the default browser
+doc-open: doc
+    @if [ "$(uname)" = "Darwin" ]; then \
+        open target/doc/settly/index.html; \
+    else \
+        xdg-open target/doc/settly/index.html; \
+    fi
+
+# ─────────────────────────────────────────────────────────────────────────────────
+# Benchmarks
+# ──────────────────────────────────────────────────────────────────────────────
+
+# Run the perf benchmark
+bench:
+    cargo bench --bench perf
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Release
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Dry-run publish to crates.io
+publish-dry:
+    cargo publish --dry-run --allow-dirty
+
+# Build a release tarball
+package: build-release
+    cargo package --allow-dirty
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Housekeeping
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Remove build artifacts
+clean:
+    cargo clean
+
+# Remove build artifacts AND the target directory
+nuke: clean
+    rm -rf target
+
+# Run rustfmt + clippy --fix to auto-correct trivial issues
+fix:
+    cargo fmt --all
+    cargo clippy --all-targets --all-features --fix --allow-dirty --allow-staged
+
+# Update the Cargo.lock to the latest compatible versions
+update:
+    cargo update
+
+# Show the resolved dependency tree
+tree:
+    cargo tree --all-features
+
+# Confirm the current toolchain matches rust-toolchain.toml
+doctor:
+    @echo "rustc:  $(rustc --version)"
+    @echo "cargo:  $(cargo --version)"
+    @echo "just:   $(just --version)"
+    @echo "task:   $(task --version 2>/dev/null || echo 'not installed')"
