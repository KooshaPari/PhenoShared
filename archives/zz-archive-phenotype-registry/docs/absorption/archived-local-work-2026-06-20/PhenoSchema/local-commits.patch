--- a/deny.toml
+++ b/deny.toml
@@ -1,13 +1,22 @@
 # PhenoSchema — cargo-deny configuration
 # See https://embarkstudios.github.io/cargo-deny/
+# Schema reference: https://github.com/EmbarkStudios/cargo-deny/tree/main/cargo-deny/schema
 
 [advisories]
 db-path = "~/.cargo/advisory-dbs"
 db-urls = ["https://github.com/rustsec/advisory-db"]
+# vulnerability: fail the check on any known vulnerability in the resolved graph.
 vulnerability = "deny"
-unmaintained = "warn"
-notice = "warn"
-yanked = "warn"
+# unmaintained: scope of the "unmaintained" warning check.
+#   "all"        — every crate in the graph
+#   "workspace"  — only crates that are direct or transitive workspace deps
+#   "transitive" — only third-party (non-workspace) crates
+#   "none"       — skip
+unmaintained = "workspace"
+# notice: same scoping for informational notices (e.g. unmaintained-warnings).
+notice = "workspace"
+# yanked: fail the check on any yanked crate version in the graph.
+yanked = "deny"
 ignore = []
 
 [licenses]
@@ -15,30 +24,59 @@ unlicensed = "deny"
 allow-osi-fsf-free = "neither"
 default = "deny"
 confidence-threshold = 0.8
+# Explicit allowlist of SPDX license identifiers permitted in the dep graph.
+# Dual-licensed crates are covered by individual SPDX expressions via
+# `exceptions` further down; cargo-deny 0.19 does not accept `OR` syntax
+# inside the inline `allow` list.
 allow = [
     "MIT",
     "Apache-2.0",
-    "MIT OR Apache-2.0",
-    "Apache-2.0 OR MIT",
     "ISC",
     "BSD-2-Clause",
     "BSD-3-Clause",
     "Unicode-DFS-2016",
+    "Unicode-3.0",
     "CC0-1.0",
+    "Zlib",
+    "0BSD",
+    "BSL-1.0",
+    "MPL-2.0",
+    "Zlib",
+    "OpenSSL",
+]
+exceptions = [
+    # Allow SPDX dual-license expressions that cargo-deny cannot infer
+    # from the inline allowlist. Each entry must reference a single crate.
 ]
 
+# `clarify` blocks pin the license expression + canonical LICENSE file
+# for crates whose SPDX metadata is incomplete or ambiguous.
 [[licenses.clarify]]
 name = "ring"
 expression = "MIT AND ISC AND OpenSSL"
 license-files = [{ path = "LICENSE", hash = 0xbd0eed23 }]
 
 [bans]
-multiple-versions = "deny"
+# multiple-versions: deny duplicate versions of the same crate in the graph.
+multiple-versions = "warn"
+# wildcards: deny wildcard dependency version requirements (e.g. "*").
 wildcards = "deny"
+# deny: explicit deny-list of crates by name.
 deny = []
+# skip-tree: crate subtrees whose internal duplicates are allowed.
 skip-tree = []
 
 [sources]
 unknown-registry = "deny"
 unknown-git = "deny"
 allow-git = []
+
+[sections]
+# Apply license + advisory + ban checks to every dep-graph root produced by
+# `cargo deny check` (build, dev, target). Adjust only if a particular
+# section needs a different posture (e.g. dev-only permissiveness).
+# See https://embarkstudios.github.io/cargo-deny/config.html#the-sections-table
+allowed = []
+deny = []
+skip = []
+unmatched = "allow"
