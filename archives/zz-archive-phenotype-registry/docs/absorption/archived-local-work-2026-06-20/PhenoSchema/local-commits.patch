diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 0000000..50117e7
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,30 @@
+# PhenoSchema — Git attributes
+# Normalise line endings across platforms
+
+* text=auto eol=lf
+
+# Rust sources
+*.rs text diff=rust
+
+# Markdown
+*.md text diff=markdown
+
+# Config files
+*.toml text
+*.yml text
+*.yaml text
+*.json text
+
+# Lock files — treat as binary to avoid merge conflicts
+Cargo.lock -text
+
+# Binary / generated
+*.png binary
+*.jpg binary
+*.ico binary
+*.svg text
+
+# Editor / platform files
+.gitattributes text
+.editorconfig text
+.gitignore text
