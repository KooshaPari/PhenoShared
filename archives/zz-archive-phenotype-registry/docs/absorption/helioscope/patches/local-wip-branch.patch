--- /dev/null
+++ b/.github/workflows/audit.yml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: MIT OR Apache-2.0
+# Tier-0: consolidated dependency audit.
+# - Pulls the latest RustSec advisory database.
+# - Audits both the root workspace (helioscope harness crates) and the
+#   codex-rs subworkspace.
+# - Posts the SARIF report to the GitHub Security tab.
+# - Concurrency: only one audit run per ref at a time; supersede PR runs.
+
+name: audit
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - "**/Cargo.lock"
+      - "**/Cargo.toml"
+      - ".github/workflows/audit.yml"
+  pull_request:
+    paths:
+      - "**/Cargo.lock"
+      - "**/Cargo.toml"
+      - ".github/workflows/audit.yml"
+  schedule:
+    - cron: "37 5 * * 3" # Wednesday 05:37 UTC
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  security-events: write
+
+# Concurrency hardening: serialize by ref, cancel superseded PR runs.
+concurrency:
+  group: audit-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+env:
+  CARGO_TERM_COLOR: always
+  RUSTSEC_IDENTITY: rustsec/audit-check
+
+jobs:
+  audit-root:
+    name: cargo-audit (root)
+    runs-on: ubuntu-24.04
+    steps:
+      - name: Checkout
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        with:
+          persist-credentials: false
+
+      - name: Run cargo-audit (root workspace)
+        uses: rustsec/audit-check@69366f33c96575abad1ee0dba8212993eecbe998
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+  audit-codex:
+    name: cargo-audit (codex-rs)
+    runs-on: ubuntu-24.04
+    defaults:
+      run:
+        working-directory: ./codex-rs
+    steps:
+      - name: Checkout
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        with:
+          persist-credentials: false
+
+      - name: Run cargo-audit (codex-rs subworkspace)
+        uses: rustsec/audit-check@69366f33c96575abad1ee0dba8212993eecbe998
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
