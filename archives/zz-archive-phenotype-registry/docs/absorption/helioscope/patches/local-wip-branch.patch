+#[cfg(test)]
+mod proptests {
+    use super::*;
+
+    /// Verify that every VerificationStatus variant round-trips through
+    /// JSON serialization / deserialization without data loss.
+    #[test]
+    fn proptest_verification_status_roundtrip() {
+        let variants = vec![
+            VerificationStatus::Pending,
+            VerificationStatus::Running,
+            VerificationStatus::Passed,
+            VerificationStatus::Failed,
+            VerificationStatus::Skipped,
+            VerificationStatus::Timeout,
+        ];
+        for variant in variants {
+            let json = serde_json::to_string(&variant).expect("serialize");
+            let back: VerificationStatus =
+                serde_json::from_str(&json).expect("deserialize");
+            assert!(
+                std::mem::discriminant(&variant) == std::mem::discriminant(&back),
+                "roundtrip mismatch for {:?}",
+                variant,
+            );
+        }
+    }
+
+    /// Verify that every VerificationType variant round-trips through
+    /// JSON serialization / deserialization without data loss.
+    #[test]
+    fn proptest_verification_type_roundtrip() {
+        let variants = vec![
+            VerificationType::Test,
+            VerificationType::Security,
+            VerificationType::Performance,
+            VerificationType::Custom,
+        ];
+        for variant in variants {
+            let json = serde_json::to_string(&variant).expect("serialize");
+            let back: VerificationType =
+                serde_json::from_str(&json).expect("deserialize");
+            assert!(
+                std::mem::discriminant(&variant) == std::mem::discriminant(&back),
+                "roundtrip mismatch for {:?}",
+                variant,
+            );
+        }
+    }
+
+    /// Verify that VerificationMetrics default + round-trips correctly.
+    #[test]
+    fn proptest_verification_metrics_roundtrip() {
+        let metrics = VerificationMetrics {
+            test_count: Some(10),
+            passed_count: Some(8),
+            failed_count: Some(2),
+            coverage_percent: Some(87.5),
+            lines_per_second: Some(1500.0),
+            latency_p50_ms: Some(42.0),
+            latency_p99_ms: Some(199.0),
+            security_findings: Some(0),
+            critical_findings: Some(0),
+        };
+        let json = serde_json::to_string(&metrics).expect("serialize");
+        let back: VerificationMetrics =
+            serde_json::from_str(&json).expect("deserialize");
+        assert_eq!(back.test_count, metrics.test_count);
+        assert_eq!(back.passed_count, metrics.passed_count);
+        assert_eq!(back.failed_count, metrics.failed_count);
+
+        // Default roundtrip
+        let default_metrics = VerificationMetrics::default();
+        let json = serde_json::to_string(&default_metrics).expect("serialize default");
+        let back_default: VerificationMetrics =
+            serde_json::from_str(&json).expect("deserialize default");
+        assert_eq!(back_default.test_count, None);
+    }
+}
