diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 00000000..763f7334
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: MIT OR Apache-2.0
+# Tier-0: release orchestrator.
+# The heavy lifting is delegated to the per-target release workflows
+# (rust-release.yml, helios-cli-release.yml, etc.) so this file stays a
+# stable, single point of entry for the team. Concurrency is locked per
+# ref to guarantee a serialized release pipeline.
+
+name: release
+
+on:
+  push:
+    tags:
+      - "v*.*.*"
+      - "rust-v*.*.*"
+      - "helios-cli-v*.*.*"
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: "Tag to cut (e.g., v1.2.3, rust-v0.2.1)"
+        required: true
+        type: string
+      dry_run:
+        description: "Dry-run mode (validate, do not publish)"
+        required: false
+        default: true
+        type: boolean
+
+permissions:
+  contents: read
+
+# Concurrency hardening: one release pipeline per ref at a time; never
+# cancel an in-flight release (use a separate tag for a hotfix instead).
+concurrency:
+  group: release-${{ github.ref }}
+  cancel-in-progress: false
+
+env:
+  CARGO_TERM_COLOR: always
+  RUST_BACKTRACE: "1"
+
+jobs:
+  preflight:
+    name: Tag preflight
+    runs-on: ubuntu-24.04
+    outputs:
+      is_rust_tag: ${{ steps.parse.outputs.is_rust_tag }}
+      is_cli_tag: ${{ steps.parse.outputs.is_cli_tag }}
+      is_root_tag: ${{ steps.parse.outputs.is_root_tag }}
+      version: ${{ steps.parse.outputs.version }}
+      dry_run: ${{ steps.parse.outputs.dry_run }}
+    steps:
+      - name: Checkout
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        with:
+          persist-credentials: false
+
+      - name: Install Rust toolchain
+        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8
+
+      - name: Parse tag
+        id: parse
+        shell: bash
+        run: |
+          set -euo pipefail
+          ref_name="${GITHUB_REF_NAME:-}"
+          dry_run='false'
+          if [[ "${GITHUB_EVENT_NAME}" == "workflow_dispatch" ]]; then
+            ref_name="${{ github.event.inputs.tag }}"
+            if [[ "${{ github.event.inputs.dry_run }}" == "true" ]]; then
+              dry_run='true'
+            fi
+          fi
+
+          is_rust_tag='false'
+          is_cli_tag='false'
+          is_root_tag='false'
+          version=''
+
+          if [[ "${ref_name}" =~ ^rust-v([0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta)(\.[0-9]+)?)?)$ ]]; then
+            is_rust_tag='true'
+            version="${BASH_REMATCH[1]}"
+          elif [[ "${ref_name}" =~ ^helios-cli-v([0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta)(\.[0-9]+)?)?)$ ]]; then
+            is_cli_tag='true'
+            version="${BASH_REMATCH[1]}"
+          elif [[ "${ref_name}" =~ ^v([0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta)(\.[0-9]+)?)?)$ ]]; then
+            is_root_tag='true'
+            version="${BASH_REMATCH[1]}"
+          else
+            echo "::error::Ref '${ref_name}' does not match a known release tag pattern."
+            exit 1
+          fi
+
+          echo "is_rust_tag=${is_rust_tag}" >> "${GITHUB_OUTPUT}"
+          echo "is_cli_tag=${is_cli_tag}" >> "${GITHUB_OUTPUT}"
+          echo "is_root_tag=${is_root_tag}" >> "${GITHUB_OUTPUT}"
+          echo "version=${version}" >> "${GITHUB_OUTPUT}"
+          echo "dry_run=${dry_run}" >> "${GITHUB_OUTPUT}"
+          echo "Detected tag=${ref_name} version=${version} dry_run=${dry_run}"
+
+  rust-release:
+    name: rust-release fanout
+    needs: preflight
+    if: needs.preflight.outputs.is_rust_tag == 'true'
+    uses: ./.github/workflows/rust-release.yml
+    with:
+      # rust-release.yml triggers on push of `rust-v*.*.*` tags; for
+      # workflow_dispatch runs we re-emit the tag on a synthetic ref.
+      ref: ${{ github.ref }}
+    secrets: inherit
+
+  cli-release:
+    name: helios-cli-release fanout
+    needs: preflight
+    if: needs.preflight.outputs.is_cli_tag == 'true'
+    uses: ./.github/workflows/helios-cli-release.yml
+    with:
+      ref: ${{ github.ref }}
+    secrets: inherit
