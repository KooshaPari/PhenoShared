+        status: HealthStatus::Healthy,
+    });
+    monitor.add_checker(StubChecker {
+        name: "b",
+        status: HealthStatus::Unhealthy,
+    });
+    assert_eq!(monitor.overall_status().await, HealthStatus::Unhealthy);
