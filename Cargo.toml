# lancedb >= 0.33 is a security floor, not a preference: lancedb 0.31 depends
# on `lance-testing` as a NORMAL dependency, and lance-testing enables pprof's
# `flamegraph` feature -> inferno 0.11 -> quick-xml 0.26.0, which carries
# RUSTSEC-2026-0194 and RUSTSEC-2026-0195 (both DoS, fixed in quick-xml 0.41).
# From lancedb 0.33 on, lance-testing is a dev-dependency, which cargo does not
# resolve, so the whole inferno/quick-xml 0.26 chain leaves Cargo.lock.
# Do not lower this back to 0.31 without re-running `cargo audit`.
lancedb = "0.33"
metal = "0.27"
metrics = { version = "0.24", default-features = false }
