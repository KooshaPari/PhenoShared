<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pheno.benchmark.every10m</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/<REDACTED>/CodeProjects/Phenotype/pheno-harness/scripts/cron/every_10m.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>600</integer>  <!-- 10 minutes in seconds -->

    <key>StandardOutPath</key>
    <string>/tmp/pheno-cron.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pheno-cron.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PHENO_ROOT</key>
        <string>/Users/<REDACTED>/CodeProjects/Phenotype/pheno-harness</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
