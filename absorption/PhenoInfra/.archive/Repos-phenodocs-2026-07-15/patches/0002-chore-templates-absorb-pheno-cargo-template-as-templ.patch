+# pheno-cargo-template canonical justfile (L2 #27).
+#
+# Mirrors the recipes in `Taskfile.yml` for CI consumers that prefer
+# `just` (e.g. projects that have a hard `just` requirement in CI).
+#
+# The `set shell := ["bash", "-uc"]` directive turns on:
+#   -u  error on unset variables (fail loud, fail fast)
+#   -c  pipefail — propagate the exit status of the first failing
+#      command in a pipe, so a `cargo ... | tail -5` cannot mask a
+#      cargo failure.
+# This guards against silent partial failures in long cargo pipelines.
+#
+# Usage: `just <recipe>` (run from the repo root).
+# Run `just` with no args to see the list below.
+
+set shell := ["bash", "-uc"]
+set dotenv-load
+
+# Toolchain / scope
+cargo  := "cargo"
+ws     := "--workspace"
+
+# Mirror the Taskfile `LONG_TIMEOUT` so both runners surface the
+# failure consistently when a `cargo` invocation hangs (per the L1
+# audit baseline that found `cargo check` did not complete within
+# 300s bounded local runs).
+long_timeout  := "10m"
+
+# Default: list recipes.
+default:
+    @just --list
+
+# ---------- Build / test / lint / format ----------
+
+# `cargo test --workspace` with an explicit timeout.
+test timeout=long_timeout:
+    timeout {{timeout}} {{cargo}} test {{ws}}
+
+# `cargo build --workspace` with an explicit timeout.
+build timeout=long_timeout:
+    timeout {{timeout}} {{cargo}} build {{ws}}
+
+# `cargo clippy --workspace --all-targets --all-features -- -D warnings`.
+lint:
+    {{cargo}} clippy {{ws}} --all-targets --all-features -- -D warnings
+
+# `cargo fmt --all -- --check` (idempotent format check).
+fmt:
+    {{cargo}} fmt --all -- --check
+
+# `cargo fmt --all` (apply formatting; not part of ci).
+fmt-fix:
+    {{cargo}} fmt --all
+
+# ---------- Supply-chain ----------
+
+# `cargo deny check` (advisories + bans + licenses + sources).
+deny:
+    {{cargo}} deny check
+
+# `cargo audit` (RustSec advisory database).
+audit:
+    {{cargo}} audit
+
+# ---------- Composed sweeps ----------
+
+# Full local CI sweep: lint + fmt + test + build + deny.
+ci: lint fmt test build deny
+    @echo "ci: all required gates passed (lint + fmt + test + build + deny)"
+
+# Code-hygiene sweep: fmt + lint + deny + audit.
+hygiene: fmt lint deny audit
+    @echo "hygiene: fmt + lint + deny + audit all clean"
+
+# Dry-run release prep: fmt + lint + test + build + deny + audit.
+release: fmt lint test build deny audit
+    @echo "release: dry-run complete; run `cargo publish` from a release branch"
+
+# Measure code coverage (SSOT: see grade.sh for the canonical command)
+coverage:
+    cargo llvm-cov --workspace --fail-under-lines 85
