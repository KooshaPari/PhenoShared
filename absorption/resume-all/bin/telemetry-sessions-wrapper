#!/bin/zsh
# telemetry-sessions-wrapper — launched by com.<REDACTED>.resume-all-telemetry
# Collects one telemetry tick every 5 minutes and appends to telemetry.ndjson.

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export HOME="/Users/<REDACTED>"

exec /usr/bin/env python3 /Users/<REDACTED>/bin/telemetry-sessions.py >> /Users/<REDACTED>/Library/Logs/resume-all/telemetry-sessions.log 2>&1
