#!/bin/zsh
# canary-runner-wrapper — launched by com.kooshapari.resume-all-canary-runner
# Runs canary health check + report every 5 minutes.

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

cd "$HOME" || exit 1
exec /opt/homebrew/bin/python3 /Users/kooshapari/bin/canary-runner.py "$@"
