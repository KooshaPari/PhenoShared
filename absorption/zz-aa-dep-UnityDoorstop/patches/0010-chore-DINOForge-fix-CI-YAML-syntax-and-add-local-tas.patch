diff --git a/Taskfile.yml b/Taskfile.yml
new file mode 100644
index 0000000000000000000000000000000000000000..73e000dfdfed4de92435029ada978ea5ec3ad153
--- /dev/null
+++ b/Taskfile.yml
@@ -0,0 +1,41 @@
+version: "3"
+
+tasks:
+  default:
+    cmds:
+      - task: build
+
+  build:
+    desc: Build all targets
+    cmds:
+      - ./build.sh
+
+  build:verbose:
+    desc: Build with verbose logging
+    cmds:
+      - ./build.sh -with_logging
+
+  build:debug:
+    desc: Build debug binaries
+    cmds:
+      - ./build.sh -with_logging -debug
+
+  build:verbose:debug:
+    desc: Build verbose debug binaries
+    cmds:
+      - ./build.sh -with_logging -debug
+
+  test:
+    desc: Run C tests
+    cmds:
+      - echo "No C tests configured yet. Add test harness to enable."
+
+  lint:
+    desc: Lint C/C++ code
+    cmds:
+      - echo "No C/C++ linter configured yet. Add clang-tidy/clang-format to enable."
+
+  clean:
+    desc: Remove build artifacts
+    cmds:
+      - rm -rf build artifacts dist
