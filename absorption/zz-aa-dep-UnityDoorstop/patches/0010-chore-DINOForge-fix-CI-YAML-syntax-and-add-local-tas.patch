From 71a9c31737a200a5276a8df1fc8e2ad7c526969a Mon Sep 17 00:00:00 2001
From: KooshaPari <42529354+KooshaPari@users.noreply.github.com>
Date: Mon, 8 Jun 2026 17:03:34 -0700
Subject: [PATCH 10/16] chore(DINOForge): fix CI YAML syntax and add local task
 runner (#12)

- Fix malformed action SHAs (double-SHA concatenation) in build-be.yml
- Replace deprecated marvinpinto/action-automatic-releases with softprops/action-gh-release
- Pin all GitHub Actions to commit SHAs
- Add permissions and concurrency blocks to all workflows
- Fix duplicate 'on:' keys in doc-links.yml
- Add Taskfile.yml for local builds
---
 .github/workflows/build-be.yml   | 28 +++++++++++++++-------
 .github/workflows/doc-links.yml  | 15 ++++++++++--
 .github/workflows/trufflehog.yml | 14 +++++++++--
 Taskfile.yml                     | 41 ++++++++++++++++++++++++++++++++
 4 files changed, 85 insertions(+), 13 deletions(-)
 create mode 100644 Taskfile.yml

diff --git a/.github/workflows/build-be.yml b/.github/workflows/build-be.yml
index 5a1ae255ba9f6d3ff1b664c262d9cd9be7c07467..6631c3a613ac9bf0500e0434a4b0b0e72f204fde 100644
--- a/.github/workflows/build-be.yml
+++ b/.github/workflows/build-be.yml
@@ -1,6 +1,16 @@
 name: Build
 
-on: [push, pull_request]
+permissions:
+  contents: read
+
+on:
+  push:
+  pull_request:
+  workflow_dispatch:
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
 
 jobs:
   build-windows:
@@ -8,7 +18,7 @@ jobs:
 
     steps:
       - name: Checkout
-        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5@11bd71901bbe5b1630ceea73d27597364c9af683
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
       - name: Configure paths
         run: |
           New-Item -ItemType Directory -Force -Path ./artifacts/release/x64
@@ -57,7 +67,7 @@ jobs:
 
     steps:
       - name: Checkout
-        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5@11bd71901bbe5b1630ceea73d27597364c9af683
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
       - name: Configure paths
         run: |
           bash -c "mkdir -p artifacts/{verbose,release,debug}/{x86,x64}"
@@ -117,7 +127,7 @@ jobs:
 
     steps:
       - name: Checkout
-        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5@11bd71901bbe5b1630ceea73d27597364c9af683
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
       - name: Configure paths
         run: |
           mkdir -p artifacts/{verbose,release,debug}/universal
@@ -171,7 +181,7 @@ jobs:
 
     steps:
       - name: Download artifacts
-        uses: actions/download-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+        uses: actions/download-artifact@6b209b229b6f44a0a69a6c61b787d5ca8eb93b0c
         with:
           path: artifacts
       - name: Grab version
@@ -188,10 +198,10 @@ jobs:
             (cd ${dir}; zip -r ../../dist/${dir}_${{ env.doorstop_version }}.zip *)
           done
       - name: Create release
-        uses: marvinpinto/action-automatic-releases@latest
+        uses: softprops/action-gh-release@c9b46fe7aad9fa02b0e7ad5eaea1df5f4206a354
         with:
-          repo_token: "${{ secrets.GITHUB_TOKEN }}"
-          automatic_release_tag: "ci"
+          token: ${{ secrets.GITHUB_TOKEN }}
+          tag_name: "ci"
           prerelease: true
-          title: "CI build"
+          name: "CI build"
           files: dist/*.zip
