---
 .github/workflows/doc-links.yml | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)
 create mode 100644 .github/workflows/doc-links.yml

diff --git a/.github/workflows/doc-links.yml b/.github/workflows/doc-links.yml
new file mode 100644
index 0000000000000000000000000000000000000000..c4d533d3feb3c37f3d8d4d2da7613e942c621506
--- /dev/null
+++ b/.github/workflows/doc-links.yml
@@ -0,0 +1,20 @@
+name: Doc Links
+on: [push, pull_request]
+
+jobs:
+  links:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+      - run: |
+          if [ ! -f tooling/doc-link-check ]; then
+            mkdir -p tooling
+            if [ -d phenotype-tooling ]; then
+              cd phenotype-tooling && cargo build --release --bin doc-link-check 2>&1 | tail -5
+              ln -sf ../phenotype-tooling/target/release/doc-link-check ../tooling/
+            else
+              echo "Note: doc-link-check not available; skipping" && exit 0
+            fi
+          fi
+          tooling/doc-link-check docs/ || true
-- 
