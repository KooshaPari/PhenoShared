From 4186d39a43635c75b7419cf4a872c36e134ff2e3 Mon Sep 17 00:00:00 2001
From: KooshaPari <42529354+KooshaPari@users.noreply.github.com>
Date: Mon, 8 Jun 2026 17:25:52 -0700
Subject: [PATCH 11/16] chore(DINOForge): add C tests and fix
 parse_target_assembly_string bug (#13)

- Add test_config.c with tests for init_config_defaults, cleanup_config,
  parse_target_assembly_string (single and multiple assemblies)
- Fix parse_target_assembly_string: save original char before replacing
  with NUL so semicolon tokens are not incorrectly treated as end-of-string
  (fixes bug where only first assembly was parsed)
- Update Taskfile.yml to run C tests via gcc
- Fix common.c NULL target_assembly check before dereference
---
 Taskfile.yml            |   2 +-
 src/config/common.c     |   2 ++
 src/config/config.h     |   5 +++
 src/nix/config.c        |  30 ++++++++++++++++
 tests/test_config       | Bin 0 -> 35720 bytes
 tests/test_config.c     |  76 ++++++++++++++++++++++++++++++++++++++++
 tests/test_config_debug | Bin 0 -> 35728 bytes
 7 files changed, 114 insertions(+), 1 deletion(-)
 create mode 100755 tests/test_config
 create mode 100644 tests/test_config.c
 create mode 100755 tests/test_config_debug

diff --git a/Taskfile.yml b/Taskfile.yml
index 73e000dfdfed4de92435029ada978ea5ec3ad153..9d0d9b05a849894c048f85b02312cac830d640bd 100644
--- a/Taskfile.yml
+++ b/Taskfile.yml
@@ -28,7 +28,7 @@ tasks:
   test:
     desc: Run C tests
     cmds:
-      - echo "No C tests configured yet. Add test harness to enable."
+      - gcc -std=c11 -I. -I./src tests/test_config.c src/config/common.c src/nix/config.c src/nix/util.c -o tests/test_config && ./tests/test_config
 
   lint:
     desc: Lint C/C++ code
diff --git a/src/config/common.c b/src/config/common.c
index 74a5015aa0474a295fd56bb0319e1b5c09c1782b..9f8118484ba8b528a4009440a90ba892325f770d 100644
--- a/src/config/common.c
+++ b/src/config/common.c
@@ -23,6 +23,7 @@ void cleanup_config() {
     FREE_NON_NULL(config.clr_corlib_dir);
     FREE_NON_NULL(config.clr_runtime_coreclr_path);
     FREE_NON_NULL(config.mono_debug_address);
+    FREE_NON_NULL(config.target_assembly);
 
 #undef FREE_NON_NULL
 }
@@ -41,4 +42,5 @@ void init_config_defaults() {
     config.mono_dll_search_path_override = NULL;
     config.clr_corlib_dir = NULL;
     config.clr_runtime_coreclr_path = NULL;
+    config.target_assembly = NULL;
 }
