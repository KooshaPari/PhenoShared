{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "component_id",
    "repository_id",
    "source_commit",
    "source_paths",
    "profile_ids",
    "policy_release",
    "owner_role",
    "state",
    "consumer_evidence_refs"
  ],
  "properties": {
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_release": {
      "type": "string",
      "minLength": 1
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "example_not_observed",
        "unassessed",
        "declared",
        "resolved",
        "executed",
        "verified",
        "installed",
        "adopted"
      ]
    },
    "consumer_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
