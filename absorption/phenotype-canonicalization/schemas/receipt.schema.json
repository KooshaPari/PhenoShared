{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source_commit",
    "evaluator_commit",
    "profile_id",
    "tool_fingerprint",
    "producer_id",
    "artifact_digest",
    "measurements"
  ],
  "properties": {
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_commit": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_digest": {
      "type": "string",
      "minLength": 1
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "family",
          "status",
          "covered",
          "eligible",
          "failed",
          "exit_code",
          "evidence_ref"
        ],
        "properties": {
          "family": {
            "enum": [
              "unit_structural",
              "unit_behavioral",
              "integration",
              "e2e",
              "mutation",
              "critical"
            ]
          },
          "status": {
            "enum": [
              "executed",
              "not_run",
              "skipped",
              "blocked",
              "failed"
            ]
          },
          "covered": {
            "type": "number",
            "minimum": 0
          },
          "eligible": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "exit_code": {
            "type": "integer"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
