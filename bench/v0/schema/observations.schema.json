{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pheno.bench.v0.observation.v1",
  "title": "V0 measured observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "case_id",
    "status",
    "evidence_class",
    "provenance",
    "gpu_uuids",
    "gpu_telemetry",
    "measurements",
    "block_reason"
  ],
  "properties": {
    "schema_version": { "const": "pheno.bench.v0.observation.v1" },
    "observation_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "case_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "enum": ["measured", "blocked"] },
    "evidence_class": { "enum": ["local_measured", "blocked"] },
    "provenance": { "$ref": "#/$defs/provenance" },
    "gpu_uuids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gpu_uuid" },
      "uniqueItems": true
    },
    "gpu_telemetry": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/gpu_uuid" },
      "additionalProperties": { "$ref": "#/$defs/gpu_telemetry_entry" }
    },
    "measurements": {
      "oneOf": [{ "type": "null" }, { "type": "object" }]
    },
    "block_reason": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 512 }]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gpu_uuid": {
      "type": "string",
      "pattern": "^GPU-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_sha256",
        "model_sha256",
        "fixture_sha256",
        "environment_sha256",
        "phenocompose_run_sha256",
        "nvms_provenance_sha256"
      ],
      "properties": {
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "model_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "environment_sha256": { "$ref": "#/$defs/sha256" },
        "phenocompose_run_sha256": { "$ref": "#/$defs/sha256" },
        "nvms_provenance_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gpu_telemetry_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utilization_percent",
        "memory_used_mib",
        "memory_total_mib",
        "power_watts",
        "temperature_c"
      ],
      "properties": {
        "utilization_percent": { "oneOf": [{ "type": "null" }, { "type": "number" }] },
        "memory_used_mib": { "oneOf": [{ "type": "null" }, { "type": "number" }] },
        "memory_total_mib": { "oneOf": [{ "type": "null" }, { "type": "number" }] },
        "power_watts": { "oneOf": [{ "type": "null" }, { "type": "number" }] },
        "temperature_c": { "oneOf": [{ "type": "null" }, { "type": "number" }] }
      }
    }
  }
}
