{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pheno.bench.v0.derived.v1",
  "title": "V0 derived metric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "derived_id",
    "case_id",
    "evidence_class",
    "provenance",
    "source_observation_ids",
    "metrics"
  ],
  "properties": {
    "schema_version": { "const": "pheno.bench.v0.derived.v1" },
    "derived_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "case_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "evidence_class": { "const": "derived" },
    "provenance": { "$ref": "observations.schema.json#/$defs/provenance" },
    "source_observation_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "uniqueItems": true
    },
    "metrics": { "type": "object" }
  }
}
