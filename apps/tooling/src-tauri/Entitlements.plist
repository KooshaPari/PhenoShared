<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal entitlements for Tauri 2 desktop apps (phenotype tooling).

  Hardened runtime + JIT + outbound network client.
  The tooling desktop app connects to local dev tools (macOS signing
  pipeline, Infisical secret fetch, cargo build helpers) so network
  client is required.

  See: https://developer.apple.com/documentation/bundleresources/entitlements
-->
<plist version="1.0">
<dict>
  <!-- Required: hardened runtime for notarization. Set via --options=runtime during sign. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Network client: outbound HTTP for Infisical + dev tools + cargo helpers. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!--
    If the app spawns child processes or shells out, you may need:
      <key>com.apple.security.inherit</key>
      <true/>

    If the app reads/writes files outside its sandbox (e.g. ~/Downloads):
      <key>com.apple.security.files.user-selected.read-write</key>
      <true/>
      <key>com.apple.security.files.downloads.read-write</key>
      <true/>

    Apple Silicon Metal compute (uncomment if the app uses GPU via tauri-plugin-shell etc):
      <key>com.apple.security.device.metal</key>
      <true/>
  -->
</dict>
</plist>
