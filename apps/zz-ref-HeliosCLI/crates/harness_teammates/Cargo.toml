[package]
name = "harness_teammates"
version = "0.2.1"
authors = ["kooshapari"]
categories = ["development-tools::testing"]
documentation = "https://docs.rs/harness_teammates"
edition = "2021"
keywords = ["phenotype", "helios", "harness"]
license = "MIT OR Apache-2.0"
repository = "https://github.com/KooshaPari/HeliosCLI"
description = "harness teammates — Phenotype infrastructure crate (HeliosCLI)"

[dependencies]
serde = { version = "1.0", features = ["derive"] }
thiserror = "2"
tokio = { version = "1", features = ["sync", "rt"] }
tracing = "0.1"
uuid = { version = "1.0", features = ["v4"] }

[dev-dependencies]
tokio = { version = "1", features = ["full"] }

[lib]
path = "src/lib.rs"
