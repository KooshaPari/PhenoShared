[package]
name = "harness_spec"
version = "0.2.1"
authors = ["kooshapari"]
categories = ["development-tools::testing"]
documentation = "https://docs.rs/harness_spec"
edition = "2021"
keywords = ["phenotype", "helios", "harness"]
license = "MIT OR Apache-2.0"
repository = "https://github.com/KooshaPari/HeliosCLI"
description = "Specification parser and validator for heliosHarness autonomous agents"

[dependencies]
async-trait = "0.1"
chrono = { version = "0.4", features = ["serde"] }
regex = "1.10"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
serde_yaml = "0.9"
thiserror = "1.0"
tokio = { version = "1.0", features = ["full"] }
tracing = "0.1"
uuid = { version = "1.0", features = ["v4", "serde"] }

[dev-dependencies]
rstest = "0.18"
tokio-test = "0.4"

[features]
default = []
