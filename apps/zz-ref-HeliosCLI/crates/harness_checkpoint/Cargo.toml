[package]
name = "harness_checkpoint"
version = "0.2.1"
authors = ["kooshapari"]
categories = ["development-tools::testing"]
documentation = "https://docs.rs/harness_checkpoint"
edition = "2021"
keywords = ["phenotype", "helios", "harness"]
license = "MIT OR Apache-2.0"
repository = "https://github.com/KooshaPari/HeliosCLI"
description = "Checkpoint system for heliosHarness autonomous agents"

[dependencies]
chrono = { version = "0.4", features = ["serde"] }
git2 = "0.20"
harness_spec = { path = "../harness_spec" }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
tempfile = "3.10"
thiserror = "1.0"
tokio = { version = "1.0", features = ["full"] }
tracing = "0.1"
uuid = { version = "1.0", features = ["v4", "serde"] }

[dev-dependencies]
tokio-test = "0.4"

[features]
default = []
