[package]
name = "harness_orchestrator"
version = "0.1.0"
authors = ["kooshapari"]
categories = ["development-tools::testing"]
documentation = "https://docs.rs/harness_orchestrator"
edition = "2021"
keywords = ["phenotype", "helios", "harness"]
license = "MIT OR Apache-2.0"
repository = "https://github.com/KooshaPari/HeliosCLI"
description = "Sub-agent orchestration for heliosHarness autonomous agents"

[dependencies]
chrono = { version = "0.4", features = ["serde"] }
harness_checkpoint = { path = "../harness_checkpoint" }
harness_spec = { path = "../harness_spec" }
harness_verify = { path = "../harness_verify" }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
thiserror = "1.0"
tokio = { version = "1.0", features = ["full"] }
tracing = "0.1"
uuid = { version = "1.0", features = ["v4", "serde"] }

[dev-dependencies]
tokio-test = "0.4"

[features]
default = []
