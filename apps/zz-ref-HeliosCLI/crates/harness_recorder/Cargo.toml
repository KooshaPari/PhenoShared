[package]
name = "kla"
version = "0.1.0"
authors = ["KLA Team"]
categories = ["command-line-utilities", "multimedia", "development-tools"]
edition = "2021"
keywords = ["cli", "terminal", "recording", "automation", "gif"]
license = "MIT"
repository = "https://github.com/kooshapari/KommandLineAutomation"
description = "KLA (Kommand Line Automation) - A Playwright equivalent for beautiful CLI recordings"

[dependencies]
# Terminal and PTY handling
crossterm = "0.27"
portable-pty = "0.8"

# CLI framework
clap = { version = "4.4", features = ["derive"] }

# Async runtime
tokio = { version = "1.0", features = ["full"] }

# Serialization
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
serde_yaml = "0.9"

# Image processing and recording
gif = "0.12"
image = "0.24"

# Error handling
anyhow = "1.0"
thiserror = "1.0"

# Logging via tracing-subscriber, including its bridge for log:: macros.
log = "0.4"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }

# Terminal emulation
vt100 = "0.15"

# Phenotype-org shared terminal-UX toolkit. Used for the end-of-run recording
# summary panel; degrades to plain ASCII on non-kitty terminals / non-TTY / CI.
rck-core = { path = "../rck-core" }

# Timing and async utilities
futures = "0.3"

# OpenTelemetry
opentelemetry = "0.32"
opentelemetry-otlp = { version = "0.32", features = ["grpc-tonic", "trace", "metrics"] }
opentelemetry_sdk = { version = "0.32", features = ["rt-tokio", "trace", "metrics"] }

# File operations
tempfile = "3.8"

[dev-dependencies]
tempfile = "3.0"
tokio-test = "0.4"
