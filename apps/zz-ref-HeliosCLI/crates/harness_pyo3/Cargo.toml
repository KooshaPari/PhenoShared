[package]
name = "harness_pyo3"
version = "0.1.0"
authors = ["kooshapari"]
categories = ["development-tools::testing"]
documentation = "https://docs.rs/harness_pyo3"
edition = "2021"
keywords = ["phenotype", "helios", "harness"]
license = "MIT OR Apache-2.0"
repository = "https://github.com/KooshaPari/HeliosCLI"
description = "harness pyo3 — Phenotype infrastructure crate (HeliosCLI)"

[lib]
name = "harness_pyo3"
crate-type = ["cdylib", "rlib"]

[dependencies]
parking_lot = "0.12"
pyo3 = { version = "0.29", features = ["extension-module", "auto-initialize"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
