[package]
name = "forge_sharecli"
version = "0.1.0"
authors.workspace = true
edition.workspace = true
license.workspace = true
publish = false
rust-version.workspace = true
description = "ShareCLI realtime relay (P3.3) — in-process broadcast channels, bounded queues, hub registry, and backpressure fanout. See docs/tasks/."

[dependencies]
async-trait.workspace = true
base64.workspace = true
bytes = { workspace = true }
chrono = { workspace = true, features = ["serde"] }
clap = { workspace = true }
futures.workspace = true
parking_lot = "0.12"
serde = { workspace = true, features = ["derive"] }
serde_json.workspace = true
thiserror.workspace = true
tokio = { workspace = true, features = ["rt", "rt-multi-thread", "macros", "time", "sync", "io-util", "net", "signal"] }
tracing.workspace = true
uuid = { workspace = true, features = ["v4", "serde"] }

[dev-dependencies]
bstr.workspace = true
# Used by tests/composes_with_tracera.rs — proves ShareHub composes
# with TraceraSink at the wire-shape level. No new external deps are
# pulled in: `forge_tracera` is a workspace member declared in the
# root Cargo.toml.
forge_tracera = { workspace = true }
futures.workspace = true
# Used by tests/sse_e2e.rs — drives the live HTTP path through
# `commands::run_relay` so the integration test exercises the actual
# chunked transfer-encoded SSE stream end-to-end (not just the unit-test
# paths). The `stream` feature unlocks `Response::bytes_stream`.
reqwest = { workspace = true, features = ["stream"] }
serde_json.workspace = true
tokio = { workspace = true, features = ["rt", "rt-multi-thread", "macros", "time", "sync", "test-util"] }
