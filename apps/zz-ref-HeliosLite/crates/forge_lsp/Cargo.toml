[package]
name = "forge_lsp"
version = "0.1.0"
edition = "2024"
license = "MIT"

[dependencies]
async-trait = { workspace = true }
clap = { workspace = true }
# Portable `.cmd`/`.bat` subprocess construction (`build_command`) — the
# canonical copy lives in `forge_pheno_shell` so `forge_lsp` and
# `forge_infra` share one implementation instead of drifting copies.
forge_pheno_shell = { workspace = true }
# P2.5.1 — MCP config auto-reload watcher. `notify` is added directly here
# (rather than as a workspace dep) because it's only consumed by the
# `McpWatcher` surface and we don't want to take on the transitive dep
# tree (inotify / FSEvents / ReadDirectoryChangesW shims) for the rest
# of the workspace.
notify = "8"
serde = { workspace = true }
serde_derive = "1"
serde_json = { workspace = true }
thiserror = { workspace = true }
tokio = { workspace = true }
tracing = { workspace = true }
url = { workspace = true }

[dev-dependencies]
# `bstr` is used by the e2e integration test for lossy UTF-8 decoding
# of subprocess output. We keep it in dev-deps only because the
# runtime crate never needs byte-slice lossy decoding — only the
# `find_rust_analyzer` probe does.
bstr = { workspace = true }
tempfile = "3"
