{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phenotype:atlas-plan:1:work-item",
  "title": "work-item",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "minLength": 2
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "minLength": 2
    },
    "parent_outcome": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "write_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "lease_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "ready",
        "active",
        "blocked",
        "review",
        "accepted",
        "synthetic"
      ]
    },
    "acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "subject_id",
    "parent_outcome",
    "source_revision",
    "depends_on",
    "owner",
    "write_paths",
    "lease_id",
    "allowed_actions",
    "status",
    "acceptance_ids",
    "evidence_ids",
    "rollback",
    "synthetic"
  ],
  "additionalProperties": false
}
